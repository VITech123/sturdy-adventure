<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ProjectFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Project Fields" Width="680" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBgBrush}"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="Project Fields" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Define the fields that employees fill in when submitting work reports."
                       Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <!-- Add Field Form -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Row 1: Label + InternalName + Type + Required + Billing + Add -->
                <TextBox Grid.Row="0" Grid.Column="0" x:Name="NewFieldLabelBox" Style="{DynamicResource ModernTextBox}"
                         Margin="0,0,8,8" Padding="10,8" ToolTip="Display label shown to employees"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewInternalNameBox" Style="{DynamicResource ModernTextBox}"
                         Margin="0,0,8,8" Padding="10,8" ToolTip="Internal variable name (no spaces) for formula use"/>
                <ComboBox Grid.Row="0" Grid.Column="2" x:Name="NewFieldTypeBox" Style="{DynamicResource ModernComboBox}" Margin="0,0,8,8">
                    <ComboBoxItem Content="Text" IsSelected="True"/>
                    <ComboBoxItem Content="Number"/>
                </ComboBox>
                <CheckBox Grid.Row="0" Grid.Column="3" x:Name="NewFieldRequired" Content="Req"
                          VerticalAlignment="Center" Margin="0,0,8,8" FontSize="13"/>
                <CheckBox Grid.Row="0" Grid.Column="4" x:Name="NewFieldBilling" Content="Billing"
                          VerticalAlignment="Center" Margin="0,0,8,8" FontSize="13"/>
                <Button Grid.Row="0" Grid.Column="5" Content="+ Add Field" Style="{DynamicResource PrimaryButton}"
                        Padding="14,9" FontSize="13" Click="AddField_Click"/>
                <!-- Row 2: Instructions -->
                <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" x:Name="NewInstructionsBox"
                         Style="{DynamicResource ModernTextBox}" Margin="0,0,8,0" Padding="10,8"
                         ToolTip="Instructions shown to employees when filling this field"/>
            </Grid>
        </Border>

        <!-- Fields List -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
            <DataGrid x:Name="FieldsGrid" Style="{DynamicResource ModernDataGrid}" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field Label" Binding="{Binding FieldLabel}" Width="*"/>
                    <DataGridTextColumn Header="Internal Name" Binding="{Binding InternalFieldName}" Width="120"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Req" Binding="{Binding IsRequired}" Width="50"/>
                    <DataGridCheckBoxColumn Header="Billing" Binding="{Binding IncludeInBilling}" Width="60"/>
                    <DataGridTextColumn Header="Instructions" Binding="{Binding Instructions}" Width="2*"/>
                    <DataGridTemplateColumn Header="Del" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" Tag="{Binding Id}" Style="{DynamicResource DangerButton}"
                                        Padding="6,4" FontSize="12" Click="DeleteField_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Button Grid.Row="3" Content="Close" Style="{DynamicResource OutlineButton}"
                HorizontalAlignment="Right" Padding="20,10" Margin="0,16,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>

