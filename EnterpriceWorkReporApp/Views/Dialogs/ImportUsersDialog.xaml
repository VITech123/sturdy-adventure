<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ImportUsersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart User Import" Width="900" Height="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Smart User Import" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Create multiple employee accounts in bulk with automatic password hashing." Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{DynamicResource ModernTabControl}">
            <TabItem Header="1. File &amp; Mapping">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Select Source File" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button x:Name="BrowseBtn" Content="📁 Select File" Style="{DynamicResource PrimaryButton}" 
                                    Padding="15,8" Click="Browse_Click" DockPanel.Dock="Right"/>
                            <TextBox x:Name="FilePathBox" Style="{DynamicResource ModernTextBox}" IsReadOnly="True" 
                                     Text="Excel or CSV..." Margin="0,0,10,0"/>
                        </DockPanel>
                    </StackPanel>
                    <GroupBox Grid.Row="1" Header="Column Mapping" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MappingPanel">
                                <TextBlock Text="Upload a file to configure mapping." 
                                           HorizontalAlignment="Center" Margin="0,50,0,0" Foreground="#999"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="2. Preview &amp; Validation">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="PreviewGrid" Grid.Row="0" Style="{DynamicResource ModernDataGrid}" 
                              CanUserAddRows="True" AutoGenerateColumns="True"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock x:Name="GridStatsText" Text="Rows: 0" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold"/>
                        <Button Content="📋 Paste (Tab Delimited)" Style="{DynamicResource OutlineButton}" Padding="12,6" Click="Paste_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{DynamicResource OutlineButton}" Padding="20,10" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button x:Name="ImportBtn" Content="🚀 Create Accounts" Style="{DynamicResource PrimaryButton}" Padding="25,10" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>

