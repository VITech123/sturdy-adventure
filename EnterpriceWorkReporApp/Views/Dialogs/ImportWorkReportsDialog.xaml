<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ImportWorkReportsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Work Reports"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBgBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="RowHeight" Value="28"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Import Work Reports" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Import multiple work reports from Excel with automatic column mapping" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- File Selection -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Select Excel File" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="FilePathBox" Style="{DynamicResource ModernTextBox}" IsReadOnly="True"/>
                    <TextBlock x:Name="FileInfoText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse..." Style="{DynamicResource PrimaryButton}" Padding="20,10" VerticalAlignment="Bottom" Click="Browse_Click"/>
            </Grid>
        </Border>
        
        <!-- Data Preview & Filter -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Search & Filter -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox x:Name="GridSearchBox" Width="200" Style="{DynamicResource ModernTextBox}" Tag="Search by keyword..." Margin="0,0,12,0" TextChanged="GridSearch_Changed"/>
                    <ComboBox x:Name="FilterUserCombo" Width="150" Style="{DynamicResource ModernComboBox}" Margin="0,0,8,0" SelectionChanged="GridFilter_Changed"/>
                    <DatePicker x:Name="FilterDatePicker" Width="120" Margin="0,0,8,0" SelectedDateChanged="GridFilter_Changed"/>
                    <Button Content="Clear Filters" Style="{DynamicResource OutlineButton}" Padding="12,4" Click="ClearGridFilters_Click"/>
                </StackPanel>

                <DataGrid x:Name="PreviewGrid" Grid.Row="1" 
                          IsReadOnly="False" 
                          SelectionMode="Extended"
                          SelectionUnit="CellOrRowHeader"
                          AutoGenerateColumns="True"
                          HeadersVisibility="All"
                          GridLinesVisibility="All">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Paste Data" Click="PasteData_Click"/>
                            <MenuItem Header="Delete Selected" Click="DeleteSelected_Click"/>
                            <MenuItem Header="Clear All" Click="ClearGrid_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                
                <TextBlock x:Name="GridStatsText" Grid.Row="2" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </Border>
        
        <!-- Project Selection -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Import to Project:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="ProjectCombo" Width="200" Style="{DynamicResource ModernComboBox}" SelectionChanged="Project_SelectionChanged"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="MappingStatusText" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ImportBtn" Content="Import Reports" Style="{DynamicResource PrimaryButton}" Padding="20,10" Click="Import_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Status -->
        <Border Grid.Row="4" Background="{DynamicResource CardBgBrush}" Padding="12" Margin="0,12,0,0" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StatusText" Text="Select a file or paste data to begin..." FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
