<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project" Width="750" Height="750"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}"
        ShowInTaskbar="False"
        MinWidth="600" MinHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" x:Name="TitleText" Text="New Project" Style="{DynamicResource PageTitle}" Margin="8,0,0,16"/>

                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                    <!-- Tab 1: DETAILS -->
                    <TabItem Header="📄 Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel Margin="8">
                                <!-- Row: Name + Code -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PROJECT NAME *" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="NameBox" Style="{DynamicResource ModernTextBox}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROJECT CODE" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="ProjectCodeBox" Style="{DynamicResource ModernTextBox}"
                                                 ToolTip="Short code used for reference (e.g. PROJ01)"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="DESCRIPTION" Style="{DynamicResource FieldLabel}"/>
                                <TextBox x:Name="DescriptionBox" Style="{DynamicResource ModernTextBox}" Height="80"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,16"/>

                                <!-- Billing Formula -->
                                <TextBlock Text="BILLING FORMULA" Style="{DynamicResource FieldLabel}"/>
                                <TextBox x:Name="FormulaBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,6"/>
                                <TextBlock Text="Example: (CharacterCount / 1000) * Rate   —   use field labels as variables."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBox x:Name="TestFormulaValuesBox" Style="{DynamicResource ModernTextBox}"
                                             Width="300" Margin="0,0,10,0"
                                             ToolTip="Enter sample values as: FieldLabel=value, e.g. CharacterCount=5000, Rate=2"/>
                                    <Button Content="🧪 Test Formula" Style="{DynamicResource OutlineButton}"
                                            Padding="12,8" Click="TestFormula_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="FormulaResultText" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Master File Path -->
                                <TextBlock Text="MASTER FILE PATH" Style="{DynamicResource FieldLabel}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="MasterFilePathBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,8,0"
                                             ToolTip="Path to project master file (Excel/CSV)"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{DynamicResource OutlineButton}"
                                            Padding="10,8" Margin="0,0,8,0" Click="BrowseMasterFile_Click"/>
                                    <Button Grid.Column="2" Content="🔄 Sync" Style="{DynamicResource OutlineButton}"
                                            Padding="10,8" Click="SyncMasterFile_Click"
                                            ToolTip="Sync/validate against master file"/>
                                </Grid>
                                <TextBlock Text="Optional: Path to a master Excel/CSV file for data sync or validation."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <!-- Master File Password -->
                                <TextBlock Text="MASTER FILE PASSWORD" Style="{DynamicResource FieldLabel}"/>
                                <PasswordBox x:Name="MasterFilePasswordBox" Style="{DynamicResource ModernPasswordBox}" Margin="0,0,0,4"
                                             ToolTip="Password for password-protected Excel master files (leave blank if not protected)"/>
                                <TextBlock Text="Required only if the master Excel file is password-protected."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                <!-- Quality Report Base Path -->
                                <TextBlock Text="QUALITY REPORT BASE PATH" Style="{DynamicResource FieldLabel}"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="QualityBasePathBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,8,0"
                                             ToolTip="Base folder for quality reports (e.g., D:\demodata\Gamma142\Quality_Report)"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{DynamicResource OutlineButton}"
                                            Padding="10,8" Margin="0,0,8,0" Click="BrowseQualityPath_Click"/>
                                    <Button Grid.Column="2" Content="📊 Import Quality" Style="{DynamicResource PrimaryButton}"
                                            Padding="10,8" Click="ImportQualityReports_Click"
                                            ToolTip="Scan folder and import all quality summary reports"/>
                                </Grid>
                                <TextBlock Text="Folder structure: Quality_Report / Month / DateFolder / *SummaryReport*_Assigned.csv"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="QualityImportStatusText" Text="" FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <CheckBox x:Name="IsActiveCheck" Content="Project is Active" IsChecked="True"
                                          FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: FIELDS -->
                    <TabItem Header="⚙ Manage Fields">
                        <Grid Margin="8,16,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Add Field Form -->
                            <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Row 1 -->
                                    <TextBox Grid.Row="0" Grid.Column="0" x:Name="NewFieldLabelBox" Style="{DynamicResource ModernTextBox}"
                                             Margin="0,0,8,8" Padding="10,8" ToolTip="Display label shown to employees (e.g. CharacterCount)"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NewInternalNameBox" Style="{DynamicResource ModernTextBox}"
                                             Margin="0,0,8,8" Padding="10,8" ToolTip="Internal variable name (no spaces) for formula use"/>
                                    <ComboBox Grid.Row="0" Grid.Column="2" x:Name="NewFieldTypeBox" Style="{DynamicResource ModernComboBox}" Margin="0,0,8,8">
                                        <ComboBoxItem Content="Text" IsSelected="True"/>
                                        <ComboBoxItem Content="Number"/>
                                    </ComboBox>
                                    <CheckBox Grid.Row="0" Grid.Column="3" x:Name="NewFieldRequired" Content="Req"
                                              VerticalAlignment="Center" Margin="0,0,8,8" FontSize="13"/>
                                    <CheckBox Grid.Row="0" Grid.Column="4" x:Name="NewFieldBilling" Content="Billing"
                                              VerticalAlignment="Center" Margin="0,0,8,8" FontSize="13"/>
                                    <Button Grid.Row="0" Grid.Column="5" Content="+ Add Field" Style="{DynamicResource PrimaryButton}"
                                            Padding="14,9" FontSize="13" Click="AddField_Click"/>
                                    <!-- Row 2: Instructions -->
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" x:Name="NewInstructionsBox"
                                             Style="{DynamicResource ModernTextBox}" Margin="0,0,8,0" Padding="10,8"
                                             ToolTip="Instructions shown to employees when filling this field"/>
                                </Grid>
                            </Border>

                            <!-- Fields List -->
                            <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="0">
                                <DataGrid x:Name="FieldsGrid" Style="{DynamicResource ModernDataGrid}" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field Label" Binding="{Binding FieldLabel}" Width="*"/>
                                        <DataGridTextColumn Header="Internal Name" Binding="{Binding InternalFieldName}" Width="120"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding FieldType}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="Req" Binding="{Binding IsRequired}" Width="50"/>
                                        <DataGridCheckBoxColumn Header="Billing" Binding="{Binding IncludeInBilling}" Width="60"/>
                                        <DataGridTextColumn Header="Instructions" Binding="{Binding Instructions}" Width="2*"/>
                                        <DataGridTemplateColumn Header="Del" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" Tag="{Binding Id}" Style="{DynamicResource DangerButton}"
                                                            Padding="6,4" FontSize="12" Click="DeleteField_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: PREVIEW -->
                    <TabItem Header="👁 Form Preview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel Margin="8">
                                <TextBlock Text="This is a preview of the dynamic form generated for employees." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,0,0,16"/>
                                <Border Style="{DynamicResource CardBorder}" Padding="24" Background="#FFFFFF" HorizontalAlignment="Left" MinWidth="400">
                                    <StackPanel x:Name="PreviewPanel">
                                        <!-- Dynamic elements generated here by CS code -->
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource OutlineButton}"
                            Padding="16,10" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Save Project" Style="{DynamicResource PrimaryButton}"
                            Padding="16,10" Click="Save_Click"/>
                </StackPanel>
                
                <TextBlock Grid.Row="2" x:Name="ErrorText" Text="" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>

