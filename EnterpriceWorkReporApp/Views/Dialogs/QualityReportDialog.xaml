<Window x:Class="EnterpriseWorkReport.Views.Dialogs.QualityReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quality Report" Width="480" Height="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="32">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Add Quality Report" Style="{DynamicResource PageTitle}" Margin="0,0,0,24"/>

                <TextBlock Text="EMPLOYEE *" Style="{DynamicResource FieldLabel}"/>
                <ComboBox x:Name="EmployeeCombo" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,14"/>

                <TextBlock Text="REPORT DATE *" Style="{DynamicResource FieldLabel}"/>
                <DatePicker x:Name="ReportDate" Margin="0,0,0,14"/>

                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="ACCURACY (%)" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="AccuracyBox" Style="{DynamicResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ERROR RATE (%)" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="ErrorRateBox" Style="{DynamicResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="REWORK COUNT" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="ReworkBox" Style="{DynamicResource ModernTextBox}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="QUALITY SCORE" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="ScoreBox" Style="{DynamicResource ModernTextBox}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="REMARKS" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="RemarksBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource OutlineButton}"
                            Padding="16,10" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Save" Style="{DynamicResource PrimaryButton}"
                            Padding="16,10" Click="Save_Click"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>

