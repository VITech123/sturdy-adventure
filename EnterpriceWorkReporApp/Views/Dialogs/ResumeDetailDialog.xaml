<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ResumeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resume Details" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Candidate Resume Details" Style="{DynamicResource PageTitle}" Margin="0,0,0,16"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Image/PDF Preview -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Browse File..." Style="{DynamicResource OutlineButton}" Padding="10,5" Click="BrowseImage_Click"/>
                        <TextBlock x:Name="ImagePathText" Text="No file selected" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F9FAFB">
                        <Grid>
                            <TextBlock Text="📄" Foreground="#E5E7EB" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="ResumeImage" Stretch="Uniform" VerticalAlignment="Top"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Simple Form -->
            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Basic Information" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="Candidate Name" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="Status / Category" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="StatusCombo" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,24">
                        <ComboBoxItem Content="Pending"/>
                        <ComboBoxItem Content="Ongoing"/>
                        <ComboBoxItem Content="Rejected"/>
                        <ComboBoxItem Content="Relieved"/>
                        <ComboBoxItem Content="Work from Home"/>
                    </ComboBox>

                    <TextBlock Text="Instructions:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="• Drag and drop files into folders to categorize." TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="• Click 'Browse' to select a new resume." TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="• Use 'Refresh' to sync your local folders." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{DynamicResource OutlineButton}" Padding="20,8" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save Details" Style="{DynamicResource PrimaryButton}" Padding="20,8" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
