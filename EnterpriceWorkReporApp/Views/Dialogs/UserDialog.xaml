<Window x:Class="EnterpriseWorkReport.Views.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User" Width="480" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}" ShowInTaskbar="False"
        MinWidth="400" MinHeight="400">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="32">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="New User" Style="{DynamicResource PageTitle}" Margin="0,0,0,24"/>

                <TextBlock Text="PHOTO" Style="{DynamicResource FieldLabel}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="60" Height="60" CornerRadius="30" Background="#EEE" ClipToBounds="True">
                        <Image x:Name="ProfilePhotoPreview" Stretch="UniformToFill"/>
                    </Border>
                    <Button Grid.Column="1" Content="Upload Photo" Style="{DynamicResource OutlineButton}" 
                            HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                            Click="UploadPhoto_Click"/>
                </Grid>

                <TextBlock Text="FULL NAME *" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="FullNameBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="USERNAME *" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="EMAIL" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="EmailBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="PHONE" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="PhoneBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="PLACE" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="PlaceBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="EDUCATION" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="EducationBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="EMERGENCY CONTACT" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="EmergencyBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="JOIN DATE" Style="{DynamicResource FieldLabel}"/>
                        <DatePicker x:Name="JoinDatePicker" Margin="0,0,0,14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="RELIEVING DATE" Style="{DynamicResource FieldLabel}"/>
                        <DatePicker x:Name="RelievingDatePicker" Margin="0,0,0,14"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="PASSWORD *" Style="{DynamicResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="0" Style="{DynamicResource ModernPasswordBox}"/>
                    <Button Grid.Column="1" Content="🎲" Width="40" Margin="8,0,0,0" 
                            Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand"
                            ToolTip="Generate Password" Click="GeneratePassword_Click"/>
                </Grid>
                <TextBlock x:Name="GeneratedPasswordText" Text="" FontSize="11" 
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,14"/>

                <TextBlock Text="ROLE *" Style="{DynamicResource FieldLabel}"/>
                <ComboBox x:Name="RoleCombo" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,20">
                    <ComboBoxItem Content="Employee" IsSelected="True"/>
                    <ComboBoxItem Content="Administrator"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{DynamicResource OutlineButton}"
                            Padding="16,10" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Save User" Style="{DynamicResource PrimaryButton}"
                            Padding="16,10" Click="Save_Click"/>
                </StackPanel>
                <TextBlock x:Name="ErrorText" Text="" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>

