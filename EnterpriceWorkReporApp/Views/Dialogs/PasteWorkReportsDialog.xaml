<Window x:Class="EnterpriseWorkReport.Views.Dialogs.PasteWorkReportsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Paste Work Reports" Width="800" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bulk Paste" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Paste a table from Excel (include headers for auto-mapping)." Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="1. Paste Content Here:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="PasteInput" AcceptsReturn="True" AcceptsTab="True" 
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="PasteInput_TextChanged" FontSize="11" FontFamily="Consolas"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="2. Preview &amp; Mapping:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="PreviewGrid" Style="{DynamicResource ModernDataGrid}" 
                          IsReadOnly="True" AutoGenerateColumns="True"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" Background="#F9FAFB" Padding="16" Margin="0,20,0,0" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="3. Select Project:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ComboBox x:Name="ProjectCombo" Style="{DynamicResource ModernComboBox}" Width="300" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                <TextBlock Text="Only columns 'Object ID' (or 'ObjectId') and 'Amount' (or 'Price') will be used." FontSize="11" Foreground="#6B7280" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{DynamicResource OutlineButton}" Padding="20,10" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button x:Name="SaveBtn" Content="Import Records" Style="{DynamicResource PrimaryButton}" Padding="24,10" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

