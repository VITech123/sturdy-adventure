<Window x:Class="EnterpriseWorkReport.Views.Dialogs.LeaveCalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leave Calendar — Admin View" Width="900" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource AppBgBrush}"
        ShowInTaskbar="False" MinWidth="750" MinHeight="500">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📅 Leave Calendar" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="View approved and pending leaves for the selected month."
                       Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <!-- Month/Year Selector + Legend -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="MonthSelector" Style="{DynamicResource ModernComboBox}" Width="130"
                              Margin="0,0,12,0" SelectionChanged="Period_Changed"/>
                    <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="YearSelector" Style="{DynamicResource ModernComboBox}" Width="90"
                              Margin="0,0,20,0" SelectionChanged="Period_Changed"/>
                    <Button Content="◀ Prev" Style="{DynamicResource OutlineButton}" Padding="10,7"
                            Margin="0,0,6,0" Click="PrevMonth_Click"/>
                    <Button Content="Today" Style="{DynamicResource PrimaryButton}" Padding="10,7"
                            Margin="0,0,6,0" Click="Today_Click"/>
                    <Button Content="Next ▶" Style="{DynamicResource OutlineButton}" Padding="10,7"
                            Click="NextMonth_Click"/>
                </StackPanel>
                <!-- Legend -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#C6F6D5" CornerRadius="3" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Approved" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Background="#FEFCBF" CornerRadius="3" Width="14" Height="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Pending" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Calendar Grid -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <!-- Day headers -->
                <RowDefinition Height="36"/>
                <!-- 6 week rows max -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Day-of-week headers -->
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Mon" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Tue" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Wed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Thu" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Fri" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="5" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Sat" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="6" Background="{DynamicResource PrimaryBrush}">
                <TextBlock Text="Sun" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="White" FontSize="13"/>
            </Border>

            <!-- Calendar day cells (generated from code-behind) -->
            <ItemsControl x:Name="CalendarItemsControl" Grid.Row="1" Grid.Column="0"
                          Grid.RowSpan="6" Grid.ColumnSpan="7">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="CalendarPanel" Columns="7" Rows="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5"
                                Background="{Binding CellBackground}"
                                Padding="4" MinHeight="70">
                            <StackPanel>
                                <TextBlock Text="{Binding DayNumber}" FontWeight="{Binding DayFontWeight}"
                                           FontSize="13" Foreground="{Binding DayForeground}"
                                           HorizontalAlignment="Right" Margin="0,0,2,2"/>
                                <ItemsControl ItemsSource="{Binding Leaves}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Margin="0,1,0,0" Padding="3,2"
                                                    Background="{Binding BadgeColor}">
                                                <TextBlock Text="{Binding Label}" FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="#1A202C" ToolTip="{Binding Tooltip}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Close button -->
        <Button Grid.Row="3" Content="Close" Style="{DynamicResource OutlineButton}"
                HorizontalAlignment="Right" Padding="20,10" Margin="0,16,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>

