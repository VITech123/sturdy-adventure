<Window x:Class="EnterpriseWorkReport.Views.Dialogs.ImportAttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Attendance Import" Width="950" Height="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Smart Attendance Import" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Import attendance records from Excel/CSV files with automatic user mapping." Style="{DynamicResource PageSubtitle}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{DynamicResource ModernTabControl}">
            <!-- Tab 1: File Selection & Mapping -->
            <TabItem Header="1. File &amp; Mapping">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Select Files" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button x:Name="BrowseBtn" Content="📁 Browse Files" Style="{DynamicResource PrimaryButton}" 
                                    Padding="15,8" Click="Browse_Click" DockPanel.Dock="Right"/>
                            <TextBox x:Name="FilePathBox" Style="{DynamicResource ModernTextBox}" IsReadOnly="True" 
                                     Text="No files selected..." Margin="0,0,10,0"/>
                        </DockPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Column Mapping" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MappingPanel">
                                <TextBlock Text="Upload a file first to see available columns." 
                                           HorizontalAlignment="Center" Margin="0,50,0,0" Foreground="#999"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 2: Data Preview & Corrections -->
            <TabItem Header="2. Preview &amp; Corrections">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F3F4F6" Padding="12" CornerRadius="8" Margin="0,0,0,15">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="GridSearchBox" Style="{DynamicResource ModernTextBox}" Width="150" Margin="0,0,15,0" TextChanged="Filter_Changed"/>
                            
                            <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="FilterUserCombo" Style="{DynamicResource ModernComboBox}" Width="150" Margin="0,0,15,0" SelectionChanged="Filter_Changed"/>
                            
                            <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="FilterDatePicker" Width="130" SelectedDateChanged="Filter_Changed"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="PreviewGrid" Grid.Row="1" Style="{DynamicResource ModernDataGrid}" 
                              CanUserAddRows="True" SelectionMode="Extended">
                        <!-- Columns will be auto-generated from the DataTable -->
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <TextBlock x:Name="GridStatsText" Text="Rows: 0" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="SemiBold"/>
                        <Button Content="🗑 Clear All" Style="{DynamicResource DangerButton}" Padding="12,6" Margin="0,0,10,0" Click="ClearGrid_Click"/>
                        <Button Content="📋 Paste from Clipboard" Style="{DynamicResource OutlineButton}" Padding="12,6" Click="Paste_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{DynamicResource OutlineButton}" Padding="20,10" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button x:Name="ImportBtn" Content="🚀 Import Records" Style="{DynamicResource PrimaryButton}" Padding="25,10" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>

