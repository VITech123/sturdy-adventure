<Page x:Class="EnterpriseWorkReport.Views.Pages.WorkReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Work Reports" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="Submit and manage daily work reports." Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="+ Submit Report" Style="{DynamicResource PrimaryButton}"
                                    Padding="16,9" FontSize="13" Margin="0,0,10,0" Click="AddReport_Click"/>
                            <Button Content="📥 Import Reports" Style="{DynamicResource PrimaryButton}"
                                    Padding="16,9" FontSize="13" Margin="0,0,10,0" Click="ImportReports_Click"/>
                            <Button Content="📋 Paste Table" Style="{DynamicResource PrimaryButton}"
                                    Padding="16,9" FontSize="13" Margin="0,0,10,0" Click="PasteTable_Click"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="ExportSummaryBtn" Content="📋 Summary PDF" Style="{DynamicResource OutlineButton}"
                                    Padding="14,9" FontSize="13" Click="ExportSummaryPdf_Click" Margin="0,0,10,0"/>
                            <Button x:Name="ExportDetailedBtn" Content="📄 Detailed PDF" Style="{DynamicResource OutlineButton}"
                                    Padding="14,9" FontSize="13" Click="ExportDetailedPdf_Click" Margin="0,0,10,0"/>
                            <Button Content="⬇ Export CSV" Style="{DynamicResource OutlineButton}"
                                    Padding="14,9" FontSize="13" Click="ExportCsv_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="FilterEmployeeName" Style="{DynamicResource ModernTextBox}" Width="150" Margin="0,0,10,0"
                                 Tag="Employee Name" ToolTip="Employee Name" TextChanged="Filter_Changed" />
                        <ComboBox x:Name="FilterProject" Style="{DynamicResource ModernComboBox}"
                                  Width="180" Margin="0,0,10,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All Projects"/>
                        </ComboBox>
                        <DatePicker x:Name="FilterDateFrom" Width="130" Margin="0,0,10,0"
                                    SelectedDateChanged="DateFilter_Changed"/>
                        <DatePicker x:Name="FilterDateTo" Width="130" Margin="0,0,10,0"
                                    SelectedDateChanged="DateFilter_Changed"/>
                        <Button Content="Clear" Style="{DynamicResource OutlineButton}" Padding="12,9" FontSize="13"
                                Click="ClearFilter_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- KPI Summary Cards -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="16,16,16,8">
                        <Border Style="{DynamicResource CardBorder}" Margin="0,0,8,0" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="Today" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TodayKpiText" Text="Objects: 0 | Pages: 0 | Chars: 0&#x0a;Amount: ₹0.00" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardBorder}" Margin="4,0,4,0" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="This Week" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="WeekKpiText" Text="Objects: 0 | Pages: 0 | Chars: 0&#x0a;Amount: ₹0.00" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardBorder}" Margin="8,0,0,0" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="This Month" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MonthKpiText" Text="Objects: 0 | Pages: 0 | Chars: 0&#x0a;Amount: ₹0.00" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid x:Name="ReportsGrid" Style="{DynamicResource ModernDataGrid}" MaxHeight="600" Grid.Row="1" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn x:Name="EmployeeCol" Header="Employee" Binding="{Binding EmployeeName}" Width="120"/>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="120"/>
                            <DataGridTextColumn Header="Object ID" Binding="{Binding ObjectId}" Width="100"/>
                            <DataGridTextColumn Header="Pages" Binding="{Binding PagesCount}" Width="70"/>
                            <DataGridTextColumn Header="Characters" Binding="{Binding CharacterCount}" Width="90"/>
                            <DataGridTextColumn Header="Billing" Binding="{Binding BillingAmount, StringFormat='₹{0:F2}'}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SubmissionDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                            <DataGridTemplateColumn x:Name="ActionsCol" Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📎" Tag="{Binding AttachmentPath}" Style="{DynamicResource OutlineButton}"
                                                    Padding="8,5" FontSize="12" Margin="0,0,6,0" Click="ViewAttachment_Click"
                                                    Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Open Attachment"/>
                                            <Button Content="Edit" Tag="{Binding Id}" Style="{DynamicResource PrimaryButton}"
                                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="EditReport_Click"/>
                                            <Button Content="🗑" Tag="{Binding Id}" Style="{DynamicResource DangerButton}"
                                                    Padding="10,5" FontSize="12" Click="DeleteReport_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" Padding="15" BorderBrush="#E5E7EB" BorderThickness="0,1,0,1">
                                    <StackPanel>
                                        <TextBlock Text="Additional Fields" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                                                        <TextBlock Text="{Binding FieldLabel, StringFormat='{}{0}: '}" FontWeight="SemiBold" Foreground="#666"/>
                                                        <TextBlock Text="{Binding Value}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding AdminNote, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="Admin Note: " FontWeight="SemiBold" Foreground="#666"/>
                                            <TextBlock Text="{Binding AdminNote}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="16,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Show" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0"/>
                                <ComboBox x:Name="PageSizeCombo" Width="70" SelectedIndex="1" SelectionChanged="PageSize_Changed">
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="100"/>
                                    <ComboBoxItem Content="500"/>
                                </ComboBox>
                                <TextBlock Text="records" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="PrevPageBtn" Content="Prev" Style="{DynamicResource OutlineButton}" 
                                        Padding="12,5" Margin="0,0,10,0" Click="PrevPage_Click"/>
                                <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" VerticalAlignment="Center" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <Button x:Name="NextPageBtn" Content="Next" Style="{DynamicResource OutlineButton}" 
                                        Padding="12,5" Click="NextPage_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
