<Page x:Class="EnterpriseWorkReport.Views.Pages.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Attendance Management" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="Track employee attendance. Statuses: Present, Absent, Half Day, Leave."
                           Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ClockInBtn" Content="🕐 Clock In" Style="{DynamicResource SuccessButton}"
                                Padding="14,9" FontSize="13" Margin="0,0,10,0" Click="ClockIn_Click"/>
                        <Button x:Name="ClockOutBtn" Content="🕒 Clock Out" Style="{DynamicResource WarningButton}"
                                Padding="14,9" FontSize="13" Margin="0,0,10,0" Click="ClockOut_Click"/>
                        <Button Content="+ Manual Entry" Style="{DynamicResource PrimaryButton}"
                                Padding="14,9" FontSize="13" Margin="0,0,10,0" Click="MarkAttendance_Click"/>
                                
                        <!-- Filter Controls -->
                        <TextBox x:Name="FilterEmployeeName" Style="{DynamicResource ModernTextBox}" Width="150" Margin="0,0,10,0"
                                 Tag="Employee Name" ToolTip="Employee Name" TextChanged="Filter_Changed" />
                        <DatePicker x:Name="FilterDateFrom" Width="130" Margin="0,0,10,0"
                                    SelectedDateChanged="Filter_Changed"/>
                        <DatePicker x:Name="FilterDateTo" Width="130" Margin="0,0,10,0"
                                    SelectedDateChanged="Filter_Changed"/>
                        <ComboBox x:Name="FilterStatus" Style="{DynamicResource ModernComboBox}"
                                  Width="160" Margin="0,0,10,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All Statuses"/>
                            <ComboBoxItem Content="Present"/>
                            <ComboBoxItem Content="Absent"/>
                            <ComboBoxItem Content="Half Day"/>
                            <ComboBoxItem Content="Leave"/>
                        </ComboBox>
                        <Button Content="Clear" Style="{DynamicResource OutlineButton}" Padding="12,9" FontSize="13"
                                Click="ClearFilter_Click"/>
                    </StackPanel>
                    <Button Content="⬇ Export" Style="{DynamicResource OutlineButton}" HorizontalAlignment="Right"
                            Padding="14,9" FontSize="13" Click="Export_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AttendanceGrid" Style="{DynamicResource ModernDataGrid}" MaxHeight="600" Grid.Row="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="EmployeeCol" Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="100"/>
                            <DataGridTextColumn Header="Clock In" Binding="{Binding ClockInTime}" Width="90"/>
                            <DataGridTextColumn Header="Clock Out" Binding="{Binding ClockOutTime}" Width="90"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding HoursWorkedDisplay}" Width="70"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="⚠" FontSize="10" Foreground="#F59E0B" Margin="4,0,0,0" 
                                                       VerticalAlignment="Center" ToolTip="Late Arrival"
                                                       Visibility="{Binding IsLateArrival, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="⚠" FontSize="10" Foreground="#EF4444" Margin="2,0,0,0" 
                                                       VerticalAlignment="Center" ToolTip="Early Departure"
                                                       Visibility="{Binding IsEarlyDeparture, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ActionsCol" Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Tag="{Binding Id}" Style="{DynamicResource PrimaryButton}"
                                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="EditAttendance_Click"/>
                                            <Button Content="🗑" Tag="{Binding Id}" Style="{DynamicResource DangerButton}"
                                                    Padding="10,5" FontSize="12" Click="DeleteAttendance_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="16,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Show" VerticalAlignment="Center" Foreground="#666" Margin="0,0,8,0"/>
                                <ComboBox x:Name="PageSizeCombo" Width="70" SelectedIndex="1" SelectionChanged="PageSize_Changed">
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="100"/>
                                    <ComboBoxItem Content="500"/>
                                </ComboBox>
                                <TextBlock Text="records" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="PrevPageBtn" Content="Prev" Style="{DynamicResource OutlineButton}" 
                                        Padding="12,5" Margin="0,0,10,0" Click="PrevPage_Click"/>
                                <TextBlock x:Name="PageInfoText" Text="Page 1 of 1" VerticalAlignment="Center" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <Button x:Name="NextPageBtn" Content="Next" Style="{DynamicResource OutlineButton}" 
                                        Padding="12,5" Click="NextPage_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
