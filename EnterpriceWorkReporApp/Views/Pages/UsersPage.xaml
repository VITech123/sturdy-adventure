<Page x:Class="EnterpriseWorkReport.Views.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="User Management" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="Create, edit, and manage employee and admin accounts."
                           Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="+ New User" Style="{DynamicResource PrimaryButton}"
                                Padding="16,9" FontSize="13" Margin="0,0,10,0" Click="AddUser_Click"/>
                        <ComboBox x:Name="FilterRole" Style="{DynamicResource ModernComboBox}"
                                  Width="150" Margin="0,0,10,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All Roles"/>
                            <ComboBoxItem Content="Administrator"/>
                            <ComboBoxItem Content="Employee"/>
                        </ComboBox>
                        <ComboBox x:Name="FilterStatus" Style="{DynamicResource ModernComboBox}"
                                   Width="150" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All Status"/>
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <RadioButton x:Name="ListToggle" Content="List" Style="{DynamicResource ModernRadioButton}" IsChecked="True" Checked="ViewMode_Changed"/>
                            <RadioButton x:Name="GalleryToggle" Content="Gallery" Style="{DynamicResource ModernRadioButton}" Checked="ViewMode_Changed"/>
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Style="{DynamicResource ModernTextBox}"
                                  Width="220" Padding="10,8" TextChanged="Search_Changed"/>
                        <TextBlock Text="" VerticalAlignment="Center" Margin="-30,0,12,0" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="0">
                <Grid>
                    <DataGrid x:Name="UsersGrid" Style="{DynamicResource ModernDataGrid}" MaxHeight="600"
                              MouseDoubleClick="UsersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTemplateColumn Header="User" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PrimaryBrush}" ClipToBounds="True" Margin="0,0,12,0">
                                                <Grid>
                                                    <TextBlock Text="" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                                    <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProfilePicture}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ProfilePicture}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <Button Content="{Binding FullName}" Tag="{Binding}" 
                                                        Style="{DynamicResource LinkButton}" 
                                                        Click="ViewUserDetails_Click" Cursor="Hand" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="140"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border Style="{DynamicResource BadgeSuccess}" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Active" FontSize="11" Foreground="#065F46" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#FEE2E2" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="Inactive" FontSize="11" Foreground="#991B1B" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Tag="{Binding Id}" Style="{DynamicResource PrimaryButton}"
                                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="EditUser_Click"/>
                                            <Button Content="Reset Pwd" Tag="{Binding Id}" Style="{DynamicResource OutlineButton}"
                                                    Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="ResetPassword_Click"/>
                                            <Button Content="" Tag="{Binding Id}" Style="{DynamicResource DangerButton}"
                                                    Padding="10,5" FontSize="12" Click="DeactivateUser_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox x:Name="UsersGallery" Visibility="Collapsed" Background="Transparent" BorderThickness="0" 
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="10"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource CardBorder}" Margin="8" Width="200" Padding="16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="80" Height="80" CornerRadius="40" Margin="0,0,0,16" Background="{DynamicResource PrimaryBrush}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="32"/>
                                                <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                        
                                        <Border Style="{DynamicResource BadgeSuccess}" HorizontalAlignment="Center" Padding="8,2" Margin="0,0,0,12"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>

                                        <Button Content="View Details" Tag="{Binding}" Style="{DynamicResource PrimaryButton}" 
                                                Padding="12,6" FontSize="12" Click="ViewUserDetails_Click" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
