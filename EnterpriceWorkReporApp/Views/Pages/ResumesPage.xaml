<Page x:Class="EnterpriseWorkReport.Views.Pages.ResumesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Resume Management"
      Background="{DynamicResource AppBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <DockPanel Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Candidate Resumes" Style="{DynamicResource PageTitle}"/>
                <TextBlock Text="Manage and track candidate applications" Style="{DynamicResource PageSubtitle}"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Border Style="{DynamicResource SearchBarBorder}" Margin="0,0,12,0" Width="250">
                    <Grid>
                        <TextBlock Text="Search candidates..." Margin="12,0" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVis}}"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="12,8"
                                 VerticalContentAlignment="Center" TextChanged="ApplyFilters"/>
                    </Grid>
                </Border>
                <ComboBox x:Name="FilterStatus" Width="150" Margin="0,0,12,0" Style="{DynamicResource ModernComboBox}" SelectionChanged="ApplyFilters">
                    <ComboBoxItem Content="All Status" IsSelected="True"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Ongoing"/>
                    <ComboBoxItem Content="Rejected"/>
                    <ComboBoxItem Content="Relieved"/>
                    <ComboBoxItem Content="Work from Home"/>
                </ComboBox>
                <Button Content="🔄 Refresh" Style="{DynamicResource OutlineButton}" Padding="16,8" Click="Refresh_Click" Margin="0,0,12,0"/>
                <Button Content="➕ Add New" Style="{DynamicResource PrimaryButton}" Padding="16,8" Click="AddResume_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Folders -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,24,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Folders" FontSize="16" FontWeight="SemiBold" Margin="16,16,16,12"/>
                    <ListBox x:Name="FoldersList" BorderThickness="0" Background="Transparent" 
                             SelectionChanged="FoldersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📁" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding FileCount}" FontSize="11" Foreground="#6B7280"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Resumes View -->
            <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0" SelectionChanged="ApplyFilters">
                <TabItem Header="Table View" Style="{DynamicResource ModernTabItem}">
                    <DataGrid x:Name="ResumesGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              CanUserAddRows="False"
                              Background="White"
                              RowHeight="70"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              MouseDoubleClick="ResumesGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <!-- Removed missing style references -->
                        </DataGrid.Resources>
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="MoveToFolderMenu"/>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTemplateColumn Header="Preview" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="60" Height="60" CornerRadius="4" Background="#F3F4F6" ClipToBounds="True" BorderBrush="#E5E7EB" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="📄" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ThumbnailPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Candidate Name" Binding="{Binding CandidateName}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=\{0:dd-MMM-yyyy\}}" Width="120"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="👁 View" Style="{DynamicResource GhostButton}" 
                                                    Padding="8,2" Margin="0,0,5,0" Click="ViewResume_Click" Tag="{Binding}"/>
                                            <Button Content="🗑 Delete" Style="{DynamicResource GhostButton}" 
                                                    Foreground="#EF4444" Padding="8,2" Click="DeleteResume_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Gallery View" Style="{DynamicResource ModernTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ResumesGallery" 
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="ResumesGallery_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="10"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" Height="260" Margin="10" Style="{DynamicResource CardBorder}" Cursor="Hand">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <Border Grid.Row="0" Background="#F3F4F6" CornerRadius="8,8,0,0" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="📄" Foreground="#9CA3AF" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ThumbnailPath}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            
                                            <Border Grid.Row="1" Padding="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CandidateName}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Button Content="Details" Style="{DynamicResource OutlineButton}" 
                                                                Padding="8,2" FontSize="10" Margin="0,0,5,0"
                                                                Click="ViewResume_Click" Tag="{Binding}"/>
                                                        <Button Content="📂 Open" Style="{DynamicResource PrimaryButton}" 
                                                                Padding="8,2" FontSize="10"
                                                                Click="OpenResumeFile_Click" Tag="{Binding ImagePath}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
