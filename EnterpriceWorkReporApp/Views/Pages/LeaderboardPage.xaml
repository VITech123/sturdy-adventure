<Page x:Class="EnterpriseWorkReport.Views.Pages.LeaderboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="🏆 Leaderboard" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Rankings based on billing value, work volume, quality score, and attendance."
                       Style="{DynamicResource PageSubtitle}" Margin="0,4,0,20"/>

            <!-- Period Filter -->
            <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Period:" VerticalAlignment="Center" Margin="0,0,10,0"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="PeriodSelector" Style="{DynamicResource ModernComboBox}"
                              Width="180" SelectionChanged="Period_Changed">
                        <ComboBoxItem Content="Today"/>
                        <ComboBoxItem Content="Daily"/>
                        <ComboBoxItem Content="This Week"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Monthly"/>
                        <ComboBoxItem Content="All Time"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Top 3 Podium -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Top Performers by Billing" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                    <UniformGrid Columns="3" Rows="1">
                        <!-- 2nd Place -->
                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,8,0" HorizontalAlignment="Center">
                            <Border Background="#E5E7EB" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Rank2Initial" Text="?" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="🥈" FontSize="28" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Rank2Name" Text="—" FontWeight="SemiBold" FontSize="13"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="Rank2Billing" Text="₹0" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                        <!-- 1st Place -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="50"
                                    Width="70" Height="70" HorizontalAlignment="Center">
                                <TextBlock x:Name="Rank1Initial" Text="?" FontSize="28" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="🥇" FontSize="36" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Rank1Name" Text="—" FontWeight="Bold" FontSize="15"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="Rank1Billing" Text="₹0" FontSize="14"
                                       Foreground="{DynamicResource SuccessBrush}" TextAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <!-- 3rd Place -->
                        <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,0" HorizontalAlignment="Center">
                            <Border Background="#FEF3C7" CornerRadius="50" Width="56" Height="56"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="Rank3Initial" Text="?" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="🥉" FontSize="28" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Rank3Name" Text="—" FontWeight="SemiBold" FontSize="13"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="Rank3Billing" Text="₹0" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Full Rankings - Tabbed by Metric -->
            <Border Style="{DynamicResource CardBorder}" Padding="0">
                <StackPanel>
                    <!-- Tab Strip -->
                    <StackPanel Orientation="Horizontal" Margin="16,12,0,0">
                        <Button x:Name="TabBilling" Content="💰 Billing" Style="{DynamicResource PrimaryButton}"
                                Padding="14,8" Margin="0,0,8,0" Click="TabBilling_Click"/>
                        <Button x:Name="TabQuality" Content="⭐ Quality" Style="{DynamicResource OutlineButton}"
                                Padding="14,8" Margin="0,0,8,0" Click="TabQuality_Click"/>
                        <Button x:Name="TabWorkCount" Content="📝 Work Count" Style="{DynamicResource OutlineButton}"
                                Padding="14,8" Click="TabWorkCount_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="LeaderboardGrid" Style="{DynamicResource ModernDataGrid}" Margin="0,8,0,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                        <Setter Property="Background" Value="#FFFDE7"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rank}" Value="2">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rank}" Value="3">
                                        <Setter Property="Background" Value="#FFF8F0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="🏅 Rank" Binding="{Binding RankDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Employee" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn x:Name="ColBilling" Header="Total Billing" Binding="{Binding BillingTotal, StringFormat='₹{0:F2}'}" Width="150"/>
                            <DataGridTextColumn x:Name="ColQuality" Header="Avg Quality" Binding="{Binding QualityScore, StringFormat='{}{0:F1}%'}" Width="130" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Reports" Binding="{Binding ReportCount}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

