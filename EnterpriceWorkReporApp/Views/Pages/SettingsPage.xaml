<Page x:Class="EnterpriseWorkReport.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBgBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Settings" Style="{DynamicResource PageTitle}"/>
            <TextBlock Text="Manage system settings, themes, and database operations."
                       Style="{DynamicResource PageSubtitle}" Margin="0,4,0,24"/>

            <!-- Theme Selection -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎨 Theme Color" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Choose a pastel color theme for the application" Style="{DynamicResource FieldLabel}" Margin="0,0,0,12"/>
                    
                    <WrapPanel>
                        <Button Tag="PastelBlue" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#60A5FA" Width="50" Height="50" ToolTip="Pastel Blue">
                            <Button.Template><ControlTemplate><Border Background="#60A5FA" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="PastelGreen" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#86EFAC" Width="50" Height="50" ToolTip="Pastel Green">
                            <Button.Template><ControlTemplate><Border Background="#86EFAC" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="PastelPurple" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#C4B5FD" Width="50" Height="50" ToolTip="Pastel Purple">
                            <Button.Template><ControlTemplate><Border Background="#C4B5FD" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="PastelPink" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#F9A8D4" Width="50" Height="50" ToolTip="Pastel Pink">
                            <Button.Template><ControlTemplate><Border Background="#F9A8D4" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="PastelOrange" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#FDBA74" Width="50" Height="50" ToolTip="Pastel Orange">
                            <Button.Template><ControlTemplate><Border Background="#FDBA74" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="DarkNavy" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#6366F1" Width="50" Height="50" ToolTip="Dark Navy">
                            <Button.Template><ControlTemplate><Border Background="#6366F1" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                        <Button Tag="AmoledBlack" Click="ThemeColor_Click" Margin="0,0,8,8" Cursor="Hand" Background="#000000" Width="50" Height="50" ToolTip="AMOLED Black">
                            <Button.Template><ControlTemplate><Border Background="#000000" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                    </WrapPanel>
                    
                    <TextBlock x:Name="CurrentThemeText" Text="Current: Pastel Blue" 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Personalized Wallpaper -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🖼️ Dashboard Wallpaper" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Select a background image for your dashboard. This setting is saved to your profile." 
                               Style="{DynamicResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <ItemsControl x:Name="WallpaperGallery">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,0" BorderThickness="2" CornerRadius="8" Cursor="Hand"
                                            MouseLeftButtonDown="Wallpaper_Click" Tag="{Binding FullPath}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Width="160" Height="90">
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill"/>
                                            </Border>
                                            <Border VerticalAlignment="Bottom" Background="#AA000000" CornerRadius="0,0,6,6" Padding="6,3">
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Width="20" Height="20">
                                                <TextBlock Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <CheckBox x:Name="WallpaperEnabledCheck" Content="Enable Dashboard Wallpaper" 
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      Checked="WallpaperEnabled_Changed" Unchecked="WallpaperEnabled_Changed"/>
                            <Button Content="📂 Open Folder" Style="{DynamicResource OutlineButton}"
                                    Padding="12,6" FontSize="12" Click="OpenWallpaperFolder_Click"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Content="💾 Save Wallpaper Choice" Style="{DynamicResource PrimaryButton}"
                                Padding="20,10" Click="SaveWallpaperChoice_Click"/>
                    </Grid>
                    
                    <TextBlock x:Name="WallpaperStatusText" Text="" 
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Account Settings (Change Password) -->
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔐 Account Security" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                            <TextBlock Text="Current Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="CurrentPasswordBox" Style="{DynamicResource ModernPasswordBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="New Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="NewPasswordBox" Style="{DynamicResource ModernPasswordBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,0">
                            <TextBlock Text="Confirm New Password" Style="{DynamicResource FieldLabel}"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{DynamicResource ModernPasswordBox}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Grid.Row="1" Content="Update Password" 
                                Style="{DynamicResource PrimaryButton}" Padding="20,10" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Click="ChangePassword_Click"/>
                    </Grid>
                    <TextBlock x:Name="PasswordStatusText" Text="" FontSize="12" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Network Server (LAN Access) - Admin Only -->
            <Border x:Name="LanServerSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🌐 Network Server (LAN Access)" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable network access for other computers" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="ServerStatusText" Text="Server is NOT running"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="Other users can access this info page via browser on their computers."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,16,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="StartServerBtn" Content="▶ Start Server" Style="{DynamicResource PrimaryButton}"
                                    Padding="20,10" FontSize="13" Click="StartServer_Click"/>
                            <Button x:Name="StopServerBtn" Content="⏹ Stop Server" Style="{DynamicResource DangerButton}"
                                    Padding="20,10" FontSize="13" Margin="0,8,0,0" Click="StopServer_Click"
                                    Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ServerUrlsPanel" Visibility="Collapsed" Background="#f0f7ff" 
                            CornerRadius="8" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Access URLs (share with other users):" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="ServerUrlsText" Text="" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Backup & Restore - Admin Only -->
            <Border x:Name="BackupSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="💾 Database Backup &amp; Restore" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Create Backup" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock Text="Creates a timestamped copy of the database in the backups folder."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="🗄 Backup Now" Style="{DynamicResource PrimaryButton}"
                                    Padding="16,9" FontSize="13" HorizontalAlignment="Left"
                                    Click="BackupNow_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Restore From Backup" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock Text="Select a backup file to restore the database. Current data will be replaced."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="📂 Restore Backup" Style="{DynamicResource DangerButton}"
                                    Padding="16,9" FontSize="13" HorizontalAlignment="Left"
                                    Click="RestoreBackup_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="BackupStatusText" Text="" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Audit Log Viewer - Admin Only -->
            <Border x:Name="AuditLogSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="📋 Audit Log" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Content="🔄 Refresh" Style="{DynamicResource OutlineButton}"
                                Padding="12,5" FontSize="12" Margin="16,0,0,0"
                                Click="RefreshAuditLog_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="AuditGrid" Style="{DynamicResource ModernDataGrid}" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm'}" Width="160"/>
                            <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Company Settings - Admin Only -->
            <Border x:Name="CompanySettingsSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🏢 Company Settings" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                            <TextBlock Text="Company Name" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="CompanyNameBox" Style="{DynamicResource ModernTextBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Email" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="CompanyEmailBox" Style="{DynamicResource ModernTextBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
                            <TextBlock Text="Phone" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="CompanyPhoneBox" Style="{DynamicResource ModernTextBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Tax ID" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="TaxIdBox" Style="{DynamicResource ModernTextBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,16,0">
                            <TextBlock Text="Address" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="CompanyAddressBox" Style="{DynamicResource ModernTextBox}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Grid.Row="2">
                            <TextBlock Text="Currency Symbol" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="CurrencyBox" Style="{DynamicResource ModernTextBox}" Width="80" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Company Logo" Style="{DynamicResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush_}" 
                                    Background="#FAFAFA" CornerRadius="4" Width="80" Height="80" Margin="0,0,16,0">
                                <Image x:Name="SettingsLogoImage" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <Button Content="Upload Logo" Style="{DynamicResource OutlineButton}" 
                                        Click="UploadLogo_Click" Padding="12,6" FontSize="12" HorizontalAlignment="Left"/>
                                <TextBlock Text="Recommended size: 200x200 PNG or JPG" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Master Names File Path -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Master Names File (for Fuzzy Name Matching)" Style="{DynamicResource FieldLabel}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="MasterNamesPathBox" Style="{DynamicResource ModernTextBox}" Margin="0,0,8,0"
                                     ToolTip="Path to MasterNames.xlsx containing canonical employee names"/>
                            <Button Grid.Column="1" Content="Browse" Style="{DynamicResource OutlineButton}"
                                    Padding="10,8" Click="BrowseMasterNames_Click"/>
                        </Grid>
                        <TextBlock Text="Global file used for fuzzy matching employee names across all projects (e.g., MasterNames.xlsx)"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="💾 Save Company Settings" Style="{DynamicResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Padding="20,10"
                            Click="SaveCompanySettings_Click"/>
                    <TextBlock x:Name="CompanyStatusText" Text="" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Project Path Management - Admin Only -->
            <Border x:Name="ProjectPathSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📂 Master File &amp; Quality Path Manager" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Centrally manage paths and passwords for all project master files and quality reports."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    
                    <DataGrid x:Name="ProjectPathsGrid" Style="{DynamicResource ModernDataGrid}" 
                               MaxHeight="400" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project Name" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
                            <DataGridTemplateColumn Header="Master File Path" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding MasterFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource ModernTextBox}" Padding="4" Margin="2"/>
                                            <Button Grid.Column="1" Content="..." Width="24" Height="24" Margin="2"
                                                    Click="BrowseMasterFile_GridClick" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Password" Binding="{Binding MasterFilePassword, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Last Sync" Binding="{Binding LastMasterSyncAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sync Status" Binding="{Binding LastMasterSyncStatus}" Width="140" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Actions" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Sync Now" Style="{DynamicResource OutlineButton}" Padding="8,4" Click="SyncProjectNow_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Quality Base Path" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding QualityBasePath, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{DynamicResource ModernTextBox}" Padding="4" Margin="2"/>
                                            <Button Grid.Column="1" Content="..." Width="24" Height="24" Margin="2"
                                                    Click="BrowseQualityPath_GridClick" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="💾 Save All Project Paths" Style="{DynamicResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Padding="20,10"
                            Click="SaveProjectPaths_Click"/>
                    <TextBlock x:Name="ProjectPathStatusText" Text="" FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Background Data Sync - Admin Only -->
            <Border x:Name="BackgroundSyncSection" Style="{DynamicResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔄 Automated Background Data Sync" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status: Background synchronization is active" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="SyncStatusText" Text="Last sync: Never"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="The system automatically polls all project master files every 15 minutes to keep the database updated."
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,16,0"/>
                        </StackPanel>
                        <Button Content="🔄 Sync Now" Style="{DynamicResource OutlineButton}"
                                Padding="20,10" FontSize="13" VerticalAlignment="Center"
                                Click="ManualSync_Click"/>
</Grid>
                    <Border Margin="0,16,0,0" Background="#F8FAFC" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Sync Log" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox x:Name="SyncLogTextBox" Text="" IsReadOnly="True" FontFamily="Consolas"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="160" Background="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Danger Zone: These actions cannot be undone."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,16,0"/>
                        <Button x:Name="ClearDataBtn" Grid.Column="1" Content="🗑️ Clear All Data" Style="{DynamicResource DangerButton}"
                                Padding="20,10" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"
                                Click="ClearData_Click"/>
                        <Button x:Name="LoadDemoBtn" Grid.Column="2" Content="🚀 Load Demo Data" Style="{DynamicResource DangerButton}"
                                Padding="20,10" FontSize="13" VerticalAlignment="Center"
                                Click="LoadDemo_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ℹ About" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Enterprise Work Report System" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Version 1.0.0  •  Built with .NET Framework 4.8 + WPF + SQLite"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Text="A complete workforce management platform for data services companies."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

