<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProductivitySystem</title>

    <!-- IE11 Polyfills -->
    <!--[if lt IE 12]>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/core-js/3.25.1/minified.js"></script>
    <![endif]-->

    <!-- Bootstrap 4.6.2 (IE11 stable) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
          integrity="sha384-xOolHFLEh07PJGoPkLv1IbcEPTNtaed2xpHsD9ESMhqIYd0nLMwNLD69Npy4HI+N" crossorigin="anonymous">
    <!-- Font Awesome 4.7 (IE11 safe, no modern font-display issues) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css">
    <!-- Custom Premium Styles -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- ===================== TOP NAVBAR ===================== -->
    <nav class="navbar navbar-expand navbar-dark fixed-top navbar-top">
        <!-- Brand -->
        <a class="navbar-brand font-weight-bold d-flex align-items-center" href="/" style="min-width: 200px;">
            <i class="fa fa-line-chart mr-2" style="font-size:18px;"></i>
            <span>PRODUCTIVITY</span>
            <span class="ml-1" style="color: #7EB8FF;">SYSTEM</span>
        </a>

        <!-- Global Search (Center) -->
        <div class="mx-auto d-none d-md-block" style="width: 420px;">
            <div class="input-group" style="border-radius: 4px; overflow: hidden;">
                <div class="input-group-prepend">
                    <span class="input-group-text bg-white border-0" style="padding-left:12px;">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                </div>
                <input type="text" id="globalSearchInput" class="form-control border-0"
                       placeholder="Search Object IDs, Employees, Projects..."
                       style="height:38px; font-size:13px;" />
            </div>
        </div>

        <!-- Right Side: User Profile -->
        <ul class="navbar-nav ml-auto align-items-center">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#"
                   id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <div class="mr-2 text-right d-none d-lg-block">
                        <span class="d-block small font-weight-bold" id="navUserName">Administrator</span>
                        <span class="d-block small" style="opacity:0.7; font-size:11px;" id="navUserRole">Admin</span>
                    </div>
                    <div style="width:36px; height:36px; border-radius:50%; background:#1a4a9e; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:14px; color:#fff;">
                        A
                    </div>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow-sm" aria-labelledby="userDropdown">
                    <a class="dropdown-item" href="#"><i class="fa fa-user fa-fw mr-2 text-muted"></i> Profile</a>
                    <a class="dropdown-item" href="#"><i class="fa fa-cog fa-fw mr-2 text-muted"></i> Settings</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#" id="logoutLink"><i class="fa fa-sign-out fa-fw mr-2 text-muted"></i> Logout</a>
                </div>
            </li>
        </ul>
    </nav>

    <!-- ===================== SIDEBAR ===================== -->
    <nav class="sidebar d-none d-md-block">
        <div class="pt-3">
            <span class="sidebar-section-label">MAIN</span>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link active" href="/Dashboard">
                        <i class="fa fa-dashboard"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Projects">
                        <i class="fa fa-folder-open-o"></i> Projects
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/WorkReports">
                        <i class="fa fa-tasks"></i> Work Reports
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Billing">
                        <i class="fa fa-money"></i> Billing
                    </a>
                </li>
            </ul>

            <span class="sidebar-section-label">HR & TEAM</span>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="/Attendance">
                        <i class="fa fa-clock-o"></i> Attendance
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Leave">
                        <i class="fa fa-calendar"></i> Leave
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Quality">
                        <i class="fa fa-check-square-o"></i> Quality Reports
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Leaderboard">
                        <i class="fa fa-trophy"></i> Leaderboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Messages">
                        <i class="fa fa-envelope-o"></i> Messages
                    </a>
                </li>
            </ul>

            <span class="sidebar-section-label">ADMIN</span>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="/BulkOps">
                        <i class="fa fa-upload"></i> Bulk Operations
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Users">
                        <i class="fa fa-users"></i> Users
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Settings">
                        <i class="fa fa-gear"></i> Settings
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- ===================== MAIN CONTENT ===================== -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ===================== SCRIPTS ===================== -->
    <!-- jQuery 3.5.1 (last version with full IE11 support) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"
            integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <!-- Bootstrap 4.6.2 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-Fy6S3B9q64WdZWQUiU+q4/2Lc9HpGe/27gy8hkRzb4c1N1MvK5R7DHKwX7z5Iq1" crossorigin="anonymous"></script>
    <!-- Global Site JS -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
